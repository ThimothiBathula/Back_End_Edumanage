# Prisma database connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/school_DB"

# JWT Secret Key - generated securely using crypto.randomBytes(64).toString('hex')
JWT_SECRET="your_production_secure_jwt_secret"

# Email Configuration (Nodemailer)
EMAIL_USER="admin@schoolapp.com"
EMAIL_PASS="your_app_password"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# SMS Configuration (MSG91)
SMS_PROVIDER="msg91" # or 'mock'
MSG91_API_KEY="your_msg91_api_key"
MSG91_FLOW_ID="your_flow_id"

# Application Configuration
PORT=5000
NODE_ENV="development" # development, test, production
CORS_ORIGIN="http://localhost:5173" # comma separated for multiple domains in prod
